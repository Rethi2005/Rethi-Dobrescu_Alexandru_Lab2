@page
@model Rethi_Dobrescu_Alexandru_Lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<table class="table">
    <thead>
        <tr>
            <th>Category Name</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.CategoryData.Categories)
        {
            string selectedRow = "";

            if (item.ID == Model.CategoryID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @item.CategoryName
                </td>
                <td>
                    <a asp-page="./Index"
                       asp-route-id="@item.ID">
                        Select
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryData.Books != null)
{
    <h3>Books in Selected Category</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Author</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model.CategoryData.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author?.FullName</td>
                </tr>
            }
        </tbody>
    </table>
}